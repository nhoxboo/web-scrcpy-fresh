# Sample environment configuration for web-scrcpy.
# Copy to `.env` and load with your own method (systemd, direnv, docker compose...).
# Do NOT commit the real `.env` (already in .gitignore).

# Required for production: 32+ random bytes, e.g.
#   python -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=

# Path to adb binary (optional). If unset, the first `adb` on PATH is used.
ADB_PATH=

# Local TCP port used for the scrcpy tunnel (default 5555).
SCRCPY_LOCAL_PORT=5555

# Set to 1 only when running behind a trusted reverse proxy that injects
# X-Forwarded-For. Without this, client IPs for rate-limiting come from
# request.remote_addr directly.
TRUST_PROXY=0

# Set to 1 if serving over HTTPS so the session cookie is marked Secure.
SESSION_COOKIE_SECURE=0

# Bind host (default 0.0.0.0). Use 127.0.0.1 to restrict to localhost.
BIND_HOST=0.0.0.0

# Session idle lifetime in seconds (default 86400 = 24h).
SESSION_LIFETIME_SECONDS=86400
