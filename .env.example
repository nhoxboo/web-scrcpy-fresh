# Sample environment configuration for web-scrcpy.
# Copy to `.env` and load with your own method (systemd, direnv, docker compose...).
# Do NOT commit the real `.env` (already in .gitignore).

# Required for production: 32+ random bytes, e.g.
#   python -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=

# Path to adb binary (optional). If unset, the first `adb` on PATH is used.
ADB_PATH=

# Local TCP port used for the scrcpy tunnel (default 5555).
SCRCPY_LOCAL_PORT=5555

# Set to 1 only when running behind a trusted reverse proxy that injects
# X-Forwarded-For. Without this, client IPs for rate-limiting come from
# request.remote_addr directly.
TRUST_PROXY=0

# Set to 1 if serving over HTTPS so the session cookie is marked Secure.
SESSION_COOKIE_SECURE=0

# Bind host (default 0.0.0.0). Use 127.0.0.1 to restrict to localhost.
BIND_HOST=0.0.0.0

# Session idle lifetime in seconds (default 86400 = 24h).
SESSION_LIFETIME_SECONDS=86400

# scrcpy video quality knobs. Higher = smoother / sharper but more bandwidth.
# Default 8 Mbps / 60 fps is a good balance for LAN streaming on modern phones.
# Drop to 4000000 if you see stutter on slow Wi-Fi.
SCRCPY_VIDEO_BIT_RATE=8000000
SCRCPY_MAX_FPS=60

# Cap the longest edge of the mirrored stream in pixels. 0 = device native.
# Setting 1920 on a 4K phone usually looks SHARPER (more bits per pixel at the
# same bitrate) and lighter on the browser's MSE decoder. Common values:
#   0     — native (best on low-DPI phones)
#   1920  — recommended cap for 4K phones
#   1080  — bandwidth-constrained (LTE, cross-network mirroring)
SCRCPY_MAX_SIZE=0

# Target a specific device when multiple are connected (run `adb devices` to
# list). Leave empty to let adb pick the first online one.
ADB_SERIAL=

# Display id to mirror. 0 = main display (default). Use a non-zero id only
# when you have a secondary physical display attached and listed by
# `adb shell dumpsys display | grep mDisplayId`. To get a desktop-style
# virtual display on Android 11+, use the in-UI "Virtual Desktop" toggle
# (which sends scrcpy --new-display=WxH/dpi instead of display_id).
SCRCPY_DISPLAY_ID=0

# APK install / file push limits.
# MAX_CONTENT_LENGTH is set to the larger of the two. Bump if you upload huge games.
MAX_INSTALL_SIZE_MB=500
MAX_PUSH_SIZE_MB=500
# Server-side download timeout for /api/install with `url=...`.
INSTALL_URL_TIMEOUT_SECONDS=120
# Per-IP rate limit on /api/install + /api/push (combined).
INSTALL_RATE_MAX=6
INSTALL_RATE_WINDOW_SECONDS=300

# Audit log file path (rotating, 1 MB x 3 backups). Default: ./audit.log.
AUDIT_LOG_FILE=
